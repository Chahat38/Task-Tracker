rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissive rules allowing seamless offline-first and client-sync operations
    match /users/{userId} {
      allow read, write: if true;
    }

    match /progress_entries/{entryId} {
      allow read, write: if true;
    }

    match /assigned_tasks/{taskId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

